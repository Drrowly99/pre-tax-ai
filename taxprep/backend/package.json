{
  "name": "taxprep-backend",
  "version": "1.0.0",
  "description": "Tax preparation AI backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --forceExit --detectOpenHandles",
