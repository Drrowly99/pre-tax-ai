WORKER_2_NAME=Bob
WORKER_2_PASSWORD=change-me-worker2

WORKER_3_NAME=Carol
WORKER_3_PASSWORD=change-me-worker3

WORKER_4_NAME=Dan
WORKER_4_PASSWORD=change-me-worker4

WORKER_5_NAME=Eve
